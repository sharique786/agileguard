spring:
  application:
    name: agileguard-auth-service
  profiles:
    active: local
  datasource:
    url: jdbc:h2:mem:authdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
    driver-class-name: org.h2.Driver
    username: sa
    password: ""
  jpa:
    database-platform: org.hibernate.dialect.H2Dialect
    hibernate:
      ddl-auto: create-drop
    show-sql: false
    properties:
      hibernate:
        format_sql: true
  h2:
    console:
      enabled: true
      path: /h2-console
      settings:
        web-allow-others: true

server:
  port: 8081

# JWT configuration
agileguard:
  jwt:
    # Base64-encoded 256-bit secret for HS256. CHANGE THIS IN PRODUCTION.
    secret: dGhpcyBpcyBhIHZlcnkgbG9uZyBzZWNyZXQga2V5IGZvciBhZ2lsZWd1YXJkIGp3dCBzaWduaW5n
    access-token-expiry-ms: 900000     # 15 minutes
    refresh-token-expiry-ms: 604800000 # 7 days

# Actuator
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: always

logging:
  level:
    com.agileguard: DEBUG
    org.springframework.security: WARN
