# ─────────────────────────────────────────────────────────────
# Stage 1 — Build Angular app
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies first (layer-cache friendly)
COPY package*.json ./
RUN npm ci --silent

# Copy source and build
COPY . .

# Build target controlled by BUILD_ENV (default: prod)
ARG BUILD_ENV=production
RUN npm run build:${BUILD_ENV}

# ─────────────────────────────────────────────────────────────
# Stage 2 — Nginx to serve the static bundle
# ─────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html

# Remove default nginx content
RUN rm -rf ./*

# Copy built Angular app
COPY --from=build /app/dist/agileguard-frontend .

# Custom nginx config: HTML5 pushState routing + compression + security headers
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
