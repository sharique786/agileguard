import { Component, signal, computed, OnDestroy } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormGroup, FormsModule, ReactiveFormsModule, Validators } from '@angular/forms';
import { Subject, debounceTime, distinctUntilChanged, takeUntil } from 'rxjs';
import { AiService }            from '../../core/services/ai.service';
import { JiraService }          from '../../core/services/jira.service';
import { TypeaheadComponent }   from '../../shared/components/typeahead.component';
import { TagInputComponent }    from '../../shared/components/tag-input.component';
import { GapTypeLabelPipe }    from '../../core/pipes/gap-type-label.pipe';
import {
  ValidationResult, JiraSprint, JiraUser, JiraEpic, JiraIssue,
  GeneratedStory, StoryEnhancementResponse, GapReport
} from '../../core/models';

const PROJECT = 'COMMSSURV';

@Component({
  selector: 'app-story-form',
  standalone: true,
  imports: [CommonModule, FormsModule, ReactiveFormsModule, TypeaheadComponent, TagInputComponent, GapTypeLabelPipe],
  template: `
  <div>
    <!-- Header -->
    <div class="page-header">
      <h1 class="page-title">📝 Story Editor</h1>
      <p class="page-subtitle">
        AI-powered story management — create epics, write and update JIRA stories
        <span class="badge badge-info" style="margin-left:8px">{{ projectKey }}</span>
      </p>
    </div>

    <!-- Mode tabs -->
    <div class="mode-tabs mb-24">
      <button *ngFor="let m of modes" class="mode-tab"
              [class.active]="mode() === m.key"
              (click)="setMode(m.key)">
        {{ m.icon }} {{ m.label }}
        <span class="mode-tab-desc">{{ m.desc }}</span>
      </button>
    </div>

    <!-- AI DISCLAIMER — always shown -->
    <div class="ai-disclaimer mb-20">
      <span class="disclaimer-icon">⚠️</span>
      <div>
        <strong>AI Disclaimer</strong> — Content generated by Google Gemini (LLM) may
        <strong>hallucinate</strong> and produce inaccurate or incomplete information.
        All AI-generated stories, criteria, and suggestions <strong>must be reviewed
        and approved</strong> by your team before use in any sprint.
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════
         MODE A ─ CREATE EPIC
         ══════════════════════════════════════════════════════ -->
    <ng-container *ngIf="mode() === 'epic'">
      <div class="two-col">
        <div>

          <!-- STEP 1: Epic source selection -->
          <div class="card mb-16">
            <div class="section-head">Step 1 — Epic Source</div>
            <div class="epic-source-grid">
              <label class="radio-card" [class.selected]="epicSource() === 'existing'"
                     (click)="setEpicSource('existing')">
                <input type="radio" name="epicSrc" value="existing"
                       [checked]="epicSource() === 'existing'" style="display:none">
                <span class="radio-icon">🔍</span>
                <div>
                  <div class="radio-label">Use Existing Epic</div>
                  <div class="radio-sub">Enter JIRA key → inspect stories and gaps</div>
                </div>
              </label>
              <label class="radio-card" [class.selected]="epicSource() === 'new'"
                     (click)="setEpicSource('new')">
                <input type="radio" name="epicSrc" value="new"
                       [checked]="epicSource() === 'new'" style="display:none">
                <span class="radio-icon">✨</span>
                <div>
                  <div class="radio-label">Create New Epic</div>
                  <div class="radio-sub">Fill details → AgileGuard creates Epic JIRA</div>
                </div>
              </label>
            </div>
          </div>

          <!-- STEP 2a: Fetch existing epic -->
          <div class="card mb-16" *ngIf="epicSource() === 'existing'">
            <div class="section-head">Step 2 — Fetch Existing Epic</div>
            <div class="flex gap-10 items-end mb-8">
              <div class="form-group" style="flex:1;margin-bottom:0">
                <label class="form-label required">Epic JIRA Key</label>
                <input class="form-control" [(ngModel)]="fetchEpicKey"
                       style="font-family:monospace;text-transform:uppercase"
                       placeholder="COMMSSURV-10"
                       (input)="fetchEpicKey = $any($event.target).value.toUpperCase()">
              </div>
              <button class="btn btn-primary" (click)="fetchAndInspectEpic()"
                      [disabled]="!fetchEpicKey || epicInspecting()">
                <span *ngIf="epicInspecting()" class="spinner" style="width:14px;height:14px"></span>
                {{ epicInspecting() ? 'Inspecting…' : '🔍 Fetch & Inspect' }}
              </button>
            </div>

            <!-- Epic inspection results -->
            <ng-container *ngIf="epicInspection() as insp">
              <div class="epic-info-banner">
                <div class="flex items-center gap-10">
                  <span class="badge badge-purple">{{ insp.epicKey }}</span>
                  <strong>{{ insp.epicName }}</strong>
                  <span class="badge badge-gray">{{ insp.epicStatus }}</span>
                </div>
                <div class="epic-stats-row">
                  <div class="epic-stat"><span class="es-val">{{ insp.storyCount }}</span><span class="es-lbl">Stories</span></div>
                  <div class="epic-stat"><span class="es-val" [style.color]="scoreColor(insp.averageQualityScore)">{{ insp.averageQualityScore }}</span><span class="es-lbl">Avg Score</span></div>
                  <div class="epic-stat"><span class="es-val" style="color:var(--danger)">{{ insp.flaggedStoryCount }}</span><span class="es-lbl">Flagged</span></div>
                </div>
              </div>

              <!-- Gap breakdown per existing story -->
              <div *ngIf="insp.gapReports?.length" class="mt-12">
                <div class="field-group-label mb-8">Existing Story Quality</div>
                <div *ngFor="let gr of insp.gapReports" class="gap-row"
                     [class.gap-row-flagged]="gr.flagged">
                  <div class="flex items-center gap-8 flex-1">
                    <span class="issue-key-sm">{{ gr.issueKey }}</span>
                    <div class="score-bar-wrap">
                      <div class="score-bar-fill"
                           [style.width.%]="gr.qualityScore"
                           [style.background]="scoreColor(gr.qualityScore)"></div>
                    </div>
                    <span class="score-num" [style.color]="scoreColor(gr.qualityScore)">{{ gr.qualityScore }}</span>
                    <span *ngIf="gr.flagged" class="badge badge-danger" style="font-size:10px">🚨</span>
                  </div>
                  <div *ngIf="gr.findings?.length" class="gap-findings-mini">
                    <span *ngFor="let f of gr.findings.slice(0,3)" class="finding-chip"
                          [ngClass]="'chip-' + f.severity.toLowerCase()">
                      {{ f.type | gapTypeLabel }}
                    </span>
                    <span *ngIf="gr.findings.length > 3" class="finding-chip chip-gray">
                      +{{ gr.findings.length - 3 }} more
                    </span>
                  </div>
                </div>
              </div>
            </ng-container>
          </div>

          <!-- STEP 2b: New Epic details -->
          <div class="card mb-16" *ngIf="epicSource() === 'new'">
            <div class="section-head">Step 2 — Epic Details</div>
            <form [formGroup]="epicForm">
              <div class="form-group">
                <label class="form-label required">Epic Title</label>
                <input class="form-control" formControlName="epicTitle"
                       [class.error]="ei('epicTitle')"
                       placeholder="e.g. Payments Gateway v2 — Multi-currency support">
                <div class="form-error" *ngIf="ei('epicTitle')">Required</div>
              </div>
              <div class="form-group">
                <label class="form-label required">Description
                  <span class="text-muted text-xs" style="font-weight:400"> — plain English, detailed scope</span>
                </label>
                <textarea class="form-control" formControlName="epicDescription" rows="5"
                          [class.error]="ei('epicDescription')"
                          placeholder="Describe the full scope: business goal, users affected, key features, constraints..."></textarea>
                <div class="form-error" *ngIf="ei('epicDescription')">Required (min 30 chars)</div>
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                <div class="form-group">
                  <label class="form-label required">Business Line</label>
                  <select class="form-control" formControlName="businessLine">
                    <option value="">— Select —</option>
                    <option *ngFor="let b of bizLines" [value]="b.v">{{ b.l }}</option>
                  </select>
                </div>
                <div class="form-group">
                  <label class="form-label">Priority</label>
                  <select class="form-control" formControlName="priority">
                    <option *ngFor="let p of prios" [value]="p.v">{{ p.i }} {{ p.l }}</option>
                  </select>
                </div>
              </div>
              <button type="button" class="btn btn-primary w-full justify-center"
                      (click)="createEpicInJira()"
                      [disabled]="epicForm.invalid || epicCreating()">
                <span *ngIf="epicCreating()" class="spinner" style="width:16px;height:16px"></span>
                {{ epicCreating() ? 'Creating Epic in JIRA…' : '🏗 Create Epic JIRA' }}
              </button>
            </form>
          </div>

          <!-- Created epic confirmation -->
          <div class="alert alert-success mb-16" *ngIf="createdEpic() as ce">
            ✅ Epic <strong>{{ ce.key }}</strong> — "{{ ce.summary }}" created in JIRA.
            Configure your team below and generate stories.
          </div>

          <!-- Team Configuration — shown under Create New Epic once epic is created -->
          <div class="card mb-16" *ngIf="epicSource() === 'new' && createdEpic()">
            <div class="section-head">Team Configuration</div>
            <p class="text-sm text-secondary mb-16">
              AI will size and distribute stories based on your team composition and bandwidth.
            </p>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px">
              <div class="form-group">
                <label class="form-label required">No. of Developers</label>
                <input type="number" class="form-control" [(ngModel)]="numDevs" min="1" max="20">
              </div>
              <div class="form-group">
                <label class="form-label required">No. of QA Engineers</label>
                <input type="number" class="form-control" [(ngModel)]="numQas" min="0" max="10">
              </div>
              <div class="form-group">
                <label class="form-label">Dev Bandwidth (SP/sprint)</label>
                <input type="number" class="form-control" [(ngModel)]="devBandwidth" min="1" max="21">
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="form-group">
                <app-typeahead label="Target Sprint" displayKey="name"
                  placeholder="Search sprints…"
                  [items]="sprintOpts()" [loading]="sprintsLoading()"
                  (queryChange)="loadSprints($event)"
                  (selected)="epicSprint.set($event)">
                </app-typeahead>
              </div>
              <div class="form-group">
                <app-typeahead label="Component/s" mode="multi" displayKey="name"
                  placeholder="Search components…"
                  [items]="componentOpts()" [loading]="compLoading()"
                  (queryChange)="loadComponents($event)"
                  (multiSelected)="epicComponents.set($event)">
                </app-typeahead>
              </div>
            </div>
            <div class="form-group">
              <app-tag-input label="Labels" placeholder="Add label…"
                [tags]="epicLabels()" (tagsChange)="epicLabels.set($event)">
              </app-tag-input>
            </div>
            <button class="btn btn-primary w-full justify-center"
                    (click)="generateStories()" [disabled]="epicGenerating()">
              <span *ngIf="epicGenerating()" class="spinner" style="width:16px;height:16px"></span>
              {{ epicGenerating() ? '🤖 AI generating stories…' : '🚀 Generate Stories with AI' }}
            </button>
          </div>

          <!-- STEP 3: Team config for Use Existing Epic path (shown after inspection) -->
          <div class="card mb-16"
               *ngIf="epicSource() === 'existing' && epicInspection()">
            <div class="section-head">Team Configuration</div>
            <p class="text-sm text-secondary mb-16">
              AI will size and distribute stories based on your team composition.
            </p>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px">
              <div class="form-group">
                <label class="form-label required">No. of Developers</label>
                <input type="number" class="form-control" [(ngModel)]="numDevs" min="1" max="20">
              </div>
              <div class="form-group">
                <label class="form-label required">No. of QA Engineers</label>
                <input type="number" class="form-control" [(ngModel)]="numQas" min="0" max="10">
              </div>
              <div class="form-group">
                <label class="form-label">Dev Bandwidth (SP/sprint)</label>
                <input type="number" class="form-control" [(ngModel)]="devBandwidth" min="1" max="21">
              </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="form-group">
                <app-typeahead label="Target Sprint" displayKey="name"
                  placeholder="Search sprints…"
                  [items]="sprintOpts()" [loading]="sprintsLoading()"
                  (queryChange)="loadSprints($event)"
                  (selected)="epicSprint.set($event)">
                </app-typeahead>
              </div>
              <div class="form-group">
                <app-typeahead label="Component/s" mode="multi" displayKey="name"
                  placeholder="Search components…"
                  [items]="componentOpts()" [loading]="compLoading()"
                  (queryChange)="loadComponents($event)"
                  (multiSelected)="epicComponents.set($event)">
                </app-typeahead>
              </div>
            </div>
            <div class="form-group">
              <app-tag-input label="Labels" placeholder="Add label…"
                [tags]="epicLabels()" (tagsChange)="epicLabels.set($event)">
              </app-tag-input>
            </div>
            <button class="btn btn-primary w-full justify-center"
                    (click)="generateStories()" [disabled]="epicGenerating()">
              <span *ngIf="epicGenerating()" class="spinner" style="width:16px;height:16px"></span>
              {{ epicGenerating() ? '🤖 AI generating stories…' : '🚀 Generate Stories with AI' }}
            </button>
          </div>

        </div>

        <!-- Right: Summary card -->
        <div>
          <div class="card" *ngIf="epicResult()">
            <div class="card-title">📊 Epic Analysis</div>
            <p class="text-sm mb-12">{{ epicResult()!.epicAnalysis }}</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px">
              <div class="metric-mini"><div class="mm-val">{{ epicResult()!.totalEstimatedPoints }}</div><div class="mm-lbl">Total SP</div></div>
              <div class="metric-mini"><div class="mm-val">{{ epicResult()!.estimatedSprints }}</div><div class="mm-lbl">Sprints</div></div>
              <div class="metric-mini"><div class="mm-val">{{ epicResult()!.developerStoryCount }}</div><div class="mm-lbl">Dev Stories</div></div>
              <div class="metric-mini"><div class="mm-val">{{ epicResult()!.qaStoryCount }}</div><div class="mm-lbl">QA Stories</div></div>
            </div>
            <div *ngIf="epicResult()!.recommendations" class="alert alert-info" style="font-size:12px">
              💡 {{ epicResult()!.recommendations }}
            </div>
          </div>
          <div *ngIf="!epicResult() && !epicGenerating()"
               style="text-align:center;padding:40px;color:var(--text-muted)">
            <div style="font-size:40px;margin-bottom:8px">🏗</div>
            Set up your epic source and generate stories.
          </div>
        </div>
      </div>

      <!-- Generated stories list -->
      <div *ngIf="epicResult() as er" class="mt-24">
        <h2 style="font-size:16px;font-weight:700;color:var(--primary);margin-bottom:16px">
          📋 New Stories Generated ({{ er.stories.length }})
          <span class="text-sm text-muted" style="font-weight:400;margin-left:8px">
            Review before creating in JIRA
          </span>
        </h2>
        <div *ngFor="let s of er.stories; let i = index" class="gen-card mb-12">
          <div class="gen-card-head">
            <div class="flex items-center gap-8 flex-1 min-w-0">
              <span class="idx-badge">{{ s.storyIndex }}</span>
              <span class="badge" [ngClass]="s.suggestedAssigneeRole === 'QA' ? 'badge-warning' : 'badge-info'">{{ s.suggestedAssigneeRole }}</span>
              <span class="badge badge-gray">{{ s.storyPoints }} SP</span>
              <span class="gen-title">{{ s.title }}</span>
            </div>
            <div class="flex gap-6">
              <button class="btn btn-secondary btn-sm" (click)="toggleExpGen(i)">
                {{ expandedGen().has(i) ? '▲' : '▼' }}
              </button>
              <button class="btn btn-primary btn-sm" (click)="useGeneratedStory(s)">
                ➕ Create in JIRA
              </button>
            </div>
          </div>
          <div *ngIf="expandedGen().has(i)" class="gen-card-body">
            <div class="detail-lbl">Description</div>
            <p class="text-sm mb-10">{{ s.description }}</p>
            <div class="detail-lbl">Acceptance Criteria</div>
            <pre class="ac-pre">{{ s.acceptanceCriteria }}</pre>
            <div class="detail-lbl mt-10">AI Rationale</div>
            <p class="text-sm text-secondary">{{ s.rationale }}</p>
          </div>
        </div>
        <div class="alert alert-warning mt-12" style="font-size:12px">{{ er.disclaimer }}</div>
      </div>
    </ng-container>

    <!-- ══════════════════════════════════════════════════════
         MODE B ─ CREATE STORY
         ══════════════════════════════════════════════════════ -->
    <ng-container *ngIf="mode() === 'create'">
      <div class="two-col">
        <form [formGroup]="storyForm" (ngSubmit)="submitStory()">

          <!-- Classification -->
          <div class="card mb-16">
            <div class="section-head">📋 Classification</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px">
              <div class="form-group">
                <label class="form-label required">Issue Type</label>
                <select class="form-control" formControlName="issueType">
                  <option value="Story">Story</option>
                  <option value="Bug">Bug</option>
                  <option value="Task">Task</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label required">Priority</label>
                <select class="form-control" formControlName="priority" [class.error]="si('priority')">
                  <option value="">— Select —</option>
                  <option *ngFor="let p of prios" [value]="p.v">{{ p.i }} {{ p.l }}</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label required">Business Line</label>
                <select class="form-control" formControlName="businessLine" [class.error]="si('businessLine')">
                  <option value="">— Select —</option>
                  <option *ngFor="let b of bizLines" [value]="b.v">{{ b.l }}</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Story Details (epic link HERE per requirement 2a) -->
          <div class="card mb-16">
            <div class="section-head">✍️ Story Details</div>

            <!-- Epic Link (first in story details) -->
            <div class="form-group">
              <label class="form-label">
                Epic Link
                <span class="text-muted text-xs" style="font-weight:400"> — link to parent epic for AI context</span>
              </label>
              <div class="flex gap-8">
                <input class="form-control" formControlName="epicLink"
                       style="font-family:monospace;text-transform:uppercase"
                       placeholder="COMMSSURV-5"
                       (blur)="resolveEpic()"
                       (input)="onEpicInput($event)">
                <button type="button" class="btn btn-secondary btn-sm"
                        [disabled]="epicLinkLoading() || !storyForm.value.epicLink"
                        (click)="resolveEpic()">
                  {{ epicLinkLoading() ? '⏳' : '🔍' }}
                </button>
              </div>
              <!-- Resolved epic badge -->
              <div *ngIf="resolvedEpic() as ep" class="epic-badge mt-6">
                <span class="epic-key-tag">{{ ep.issueKey }}</span>
                <span class="epic-name-tag">{{ ep.name }}</span>
                <span class="badge badge-purple" style="font-size:10px">Epic</span>
                <button type="button" class="btn-icon" (click)="clearEpic()">×</button>
              </div>
              <div *ngIf="epicNotFound()" class="form-error">Epic "{{ storyForm.value.epicLink }}" not found</div>
              <div *ngIf="resolvedEpic()" class="context-hint">
                💡 Epic context loaded — AI will tailor AC and Description to this epic's scope.
                <button type="button" class="btn btn-secondary btn-sm" style="margin-left:8px;font-size:11px"
                        (click)="suggestFromEpic()" [disabled]="epicSuggesting()">
                  {{ epicSuggesting() ? '⏳ Suggesting…' : '🔗 Suggest from Epic' }}
                </button>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label required">Summary / Title</label>
              <input class="form-control" formControlName="title"
                     [class.error]="si('title')"
                     placeholder="As a user, I want to…">
              <div class="form-error" *ngIf="si('title')">Required (min 5 chars)</div>
            </div>
            <div class="form-group">
              <label class="form-label required">Description</label>
              <textarea class="form-control" formControlName="description" rows="4"
                        [class.error]="si('description')"
                        placeholder="As a [user type], I want [goal] so that [benefit]…"></textarea>
              <div class="form-error" *ngIf="si('description')">Required (min 20 chars)</div>
            </div>
            <div class="form-group">
              <label class="form-label required">
                Acceptance Criteria
                <button type="button" class="btn btn-secondary btn-sm"
                        style="margin-left:8px;font-size:11px"
                        (click)="generateAC()" [disabled]="acGenerating()">
                  {{ acGenerating() ? '⏳' : '✨ AI Generate' }}
                </button>
              </label>
              <textarea class="form-control" formControlName="acceptanceCriteria" rows="5"
                        [class.error]="si('acceptanceCriteria')"
                        placeholder="Given [context],&#10;When [action],&#10;Then [expected outcome]"></textarea>
              <div class="form-error" *ngIf="si('acceptanceCriteria')">Required</div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="form-group">
                <label class="form-label">Story Points</label>
                <select class="form-control" formControlName="storyPoints">
                  <option value="">— Not estimated —</option>
                  <option *ngFor="let p of [1,2,3,5,8,13,21]" [value]="p">{{ p }}</option>
                </select>
              </div>
              <div class="form-group">
                <app-typeahead label="Reporter" displayKey="displayName" subKey="emailAddress"
                  placeholder="Search reporter…"
                  [items]="userOpts()" [loading]="usersLoading()"
                  (queryChange)="loadUsers($event)"
                  (selected)="storyReporter.set($event)">
                </app-typeahead>
              </div>
            </div>
          </div>

          <!-- Planning -->
          <div class="card mb-16">
            <div class="section-head">📅 Planning</div>
            <div class="form-group">
              <app-typeahead label="Sprint" displayKey="name"
                placeholder="Search sprints…"
                [items]="sprintOpts()" [loading]="sprintsLoading()"
                (queryChange)="loadSprints($event)"
                (selected)="storySprint.set($event)">
              </app-typeahead>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
              <div class="form-group">
                <app-typeahead label="Component/s" mode="multi" displayKey="name"
                  placeholder="Search components…"
                  [items]="componentOpts()" [loading]="compLoading()"
                  (queryChange)="loadComponents($event)"
                  (multiSelected)="storyComponents.set($event)">
                </app-typeahead>
              </div>
              <div class="form-group">
                <app-typeahead label="Fix Version/s" mode="multi" displayKey="name"
                  placeholder="Search versions…"
                  [items]="versionOpts()" [loading]="versionsLoading()"
                  (queryChange)="loadVersions($event)"
                  (multiSelected)="storyVersions.set($event)">
                </app-typeahead>
              </div>
            </div>
            <div class="form-group">
              <app-tag-input label="Labels" placeholder="Add a label…"
                [tags]="storyLabels()" (tagsChange)="storyLabels.set($event)">
              </app-tag-input>
            </div>
            <div class="form-group">
              <label class="form-label">Team Names</label>
              <div class="team-pills">
                <label *ngFor="let t of teamOptions" class="team-pill"
                       [class.selected]="storyTeams().includes(t)">
                  <input type="checkbox" style="display:none"
                         [checked]="storyTeams().includes(t)"
                         (change)="toggleTeam(storyTeams, t)">{{ t }}
                </label>
              </div>
            </div>
          </div>

          <!-- Submit row — blocked if checklist not complete -->
          <div *ngIf="createBlockReason()" class="alert alert-danger mb-12">
            🚫 <strong>Cannot create story:</strong> {{ createBlockReason() }}
            Please complete the required fields (marked REQUIRED in the checklist).
          </div>
          <div class="flex gap-8 mb-24">
            <button type="submit" class="btn btn-primary"
                    style="flex:1;justify-content:center"
                    [disabled]="storySaving() || !!createBlockReason()">
              <span *ngIf="storySaving()" class="spinner" style="width:16px;height:16px"></span>
              {{ storySaving() ? 'Saving…' : '💾 Create Story' }}
            </button>
            <button type="button" class="btn btn-secondary" (click)="runValidation()">
              🤖 AI Review
            </button>
          </div>
          <div class="alert alert-success" *ngIf="storySavedKey()">
            ✅ Story <strong>{{ storySavedKey() }}</strong> created!
          </div>
        </form>

        <!-- Right: AI panel + checklist -->
        <div>
          <div class="ai-panel mb-16">
            <div class="ai-panel-header">
              🤖 Gemini AI
              <span *ngIf="aiLoading()" class="spinner" style="width:15px;height:15px;margin-left:auto"></span>
            </div>
            <div *ngIf="validation() as v" class="flex items-center gap-16 mb-16">
              <div class="score-ring" [ngClass]="scoreClass(v.qualityScore)">{{ v.qualityScore }}</div>
              <div>
                <div style="font-weight:600;font-size:14px">Quality Score</div>
                <div style="font-size:12px;color:var(--text-secondary)">{{ v.summary }}</div>
              </div>
            </div>
            <div *ngIf="!validation() && !aiLoading()" style="font-size:13px;color:var(--text-secondary)">
              Start typing — AI analysis appears automatically.
            </div>
            <div *ngIf="validation()?.issues?.length">
              <div class="field-group-label">Issues Found</div>
              <div *ngFor="let iss of validation()!.issues" class="gap-item" [ngClass]="iss.severity">
                <span class="gap-severity" [ngClass]="iss.severity">{{ iss.severity }}</span>
                <div style="font-size:13px">{{ iss.message }}</div>
              </div>
            </div>
            <div *ngIf="validation()?.suggestions?.acceptanceCriteria?.length" style="margin-top:10px">
              <div class="field-group-label">
                AI Suggested AC
                <button class="btn btn-secondary btn-sm" style="font-size:11px;margin-left:8px"
                        (click)="applyAiAc()">Apply</button>
              </div>
              <div *ngFor="let ac of validation()!.suggestions!.acceptanceCriteria"
                   class="ai-suggestion">{{ ac }}</div>
            </div>
            <div *ngIf="validation()?.suggestions?.estimationHint"
                 class="alert alert-info" style="margin-top:10px;font-size:12px">
              💡 {{ validation()!.suggestions!.estimationHint }}
            </div>
          </div>

          <!-- Completion checklist -->
          <div class="card">
            <div class="card-title">Completion Checklist</div>
            <div *ngFor="let item of createChecklist()" class="checklist-row">
              <span style="font-size:16px;flex-shrink:0">{{ item.done ? '✅' : '⬜' }}</span>
              <span style="font-size:13px;flex:1"
                    [style.color]="item.done ? 'var(--success)' : 'var(--text-secondary)'">
                {{ item.label }}
              </span>
              <span *ngIf="item.required && !item.done"
                    class="badge badge-danger" style="font-size:10px">REQUIRED</span>
              <span *ngIf="!item.required && !item.done"
                    class="badge badge-gray" style="font-size:10px">OPTIONAL</span>
            </div>
          </div>
        </div>
      </div>
    </ng-container>

    <!-- ══════════════════════════════════════════════════════
         MODE C ─ UPDATE STORY
         ══════════════════════════════════════════════════════ -->
    <ng-container *ngIf="mode() === 'update'">
      <div class="two-col">
        <div>

          <!-- Load story -->
          <div class="card mb-16">
            <div class="section-head">🔍 Load Existing Story</div>
            <div class="flex gap-10 items-end">
              <div class="form-group" style="flex:1;margin-bottom:0">
                <label class="form-label">JIRA Issue Key</label>
                <input class="form-control" [(ngModel)]="updateKey"
                       style="font-family:monospace;text-transform:uppercase"
                       placeholder="COMMSSURV-123"
                       (input)="updateKey = $any($event.target).value.toUpperCase()"
                       (keydown.enter)="loadStory()">
              </div>
              <button class="btn btn-primary" (click)="loadStory()"
                      [disabled]="!updateKey || storyLoading()">
                <span *ngIf="storyLoading()" class="spinner" style="width:14px;height:14px"></span>
                {{ storyLoading() ? 'Loading…' : '📥 Load' }}
              </button>
            </div>
          </div>

          <!-- Loaded story + edit form -->
          <ng-container *ngIf="loadedStory() as ls">
            <div class="card mb-12">
              <div class="flex justify-between items-start mb-12">
                <div>
                  <div class="flex items-center gap-8 mb-4">
                    <span class="issue-key-badge">{{ ls.key }}</span>
                    <span class="badge badge-gray">{{ ls.status }}</span>
                    <span *ngIf="ls.storyPoints" class="badge badge-info">{{ ls.storyPoints }} SP</span>
                  </div>
                  <div style="font-weight:600;font-size:15px">{{ ls.summary }}</div>
                  <!-- Epic context banner -->
                  <div *ngIf="ls.epicLink" class="epic-context-banner mt-8">
                    <span class="badge badge-purple">{{ ls.epicLink }}</span>
                    <span style="font-size:12px;margin-left:8px">{{ ls.epicName || 'Epic linked' }}</span>
                    <span class="text-xs text-muted" style="margin-left:8px">
                      — Epic context will be used to improve AI suggestions
                    </span>
                  </div>
                </div>
                <button class="btn btn-primary btn-sm"
                        (click)="runEnhancement()" [disabled]="enhLoading()">
                  <span *ngIf="enhLoading()" class="spinner" style="width:14px;height:14px"></span>
                  {{ enhLoading() ? 'Analysing…' : '🤖 Get AI Suggestions' }}
                </button>
              </div>

              <!-- Apply suggestions bar -->
              <div *ngIf="enhancement() as enh" class="apply-bar mb-12">
                <div style="font-size:13px">
                  Score: <strong [style.color]="scoreColorVal(enh.qualityScore)">{{ enh.qualityScore }}</strong>
                  → Projected: <strong [style.color]="scoreColorVal(enh.improvedScore)">{{ enh.improvedScore }}</strong>
                </div>
                <div class="flex gap-6">
                  <button class="btn btn-secondary btn-sm" (click)="applyEnh('title')">Apply Title</button>
                  <button class="btn btn-secondary btn-sm" (click)="applyEnh('desc')">Apply Desc & AC</button>
                  <button class="btn btn-primary btn-sm" (click)="applyEnh('all')">Apply All</button>
                </div>
              </div>
            </div>

            <form [formGroup]="updateForm" (ngSubmit)="submitUpdate()">
              <div class="card mb-16">
                <div class="section-head">✏️ Edit Story</div>
                <div class="form-group">
                  <label class="form-label">Title</label>
                  <input class="form-control" formControlName="title">
                </div>
                <div class="form-group">
                  <label class="form-label">Description</label>
                  <textarea class="form-control" formControlName="description" rows="4"></textarea>
                </div>
                <div class="form-group">
                  <label class="form-label">Acceptance Criteria</label>
                  <textarea class="form-control" formControlName="acceptanceCriteria" rows="5"></textarea>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                  <div class="form-group">
                    <label class="form-label">Priority</label>
                    <select class="form-control" formControlName="priority">
                      <option *ngFor="let p of prios" [value]="p.v">{{ p.i }} {{ p.l }}</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Story Points</label>
                    <select class="form-control" formControlName="storyPoints">
                      <option value="">— Not estimated —</option>
                      <option *ngFor="let p of [1,2,3,5,8,13,21]" [value]="p">{{ p }}</option>
                    </select>
                  </div>
                </div>
              </div>

              <!-- Update checklist warning (req 3b) -->
              <div *ngIf="updateChecklistWarning()" class="alert alert-warning mb-12">
                ⚠️ <strong>Quality Warning:</strong> {{ updateChecklistWarning() }}
                The story can still be saved, but consider resolving these issues first.
              </div>

              <button type="submit" class="btn btn-primary w-full justify-center"
                      [disabled]="updateSaving()">
                <span *ngIf="updateSaving()" class="spinner" style="width:16px;height:16px"></span>
                {{ updateSaving() ? 'Saving…' : '💾 Save Updates to JIRA' }}
              </button>
              <div class="alert alert-success mt-12" *ngIf="updateSaved()">
                ✅ Story {{ updateKey }} updated successfully!
              </div>
            </form>
          </ng-container>
        </div>

        <!-- Right: Enhancement panel -->
        <div>
          <div *ngIf="!enhancement() && !enhLoading()"
               style="text-align:center;padding:40px;color:var(--text-muted)">
            <div style="font-size:40px;margin-bottom:8px">✏️</div>
            Load a story and click "Get AI Suggestions" to see improvement recommendations.
          </div>

          <ng-container *ngIf="enhancement() as enh">
            <!-- Score comparison -->
            <div class="card mb-16">
              <div class="card-title">📊 Quality Assessment</div>
              <div class="flex items-center gap-16 mb-12">
                <div style="text-align:center">
                  <div class="score-ring" [ngClass]="scoreClass(enh.qualityScore)">{{ enh.qualityScore }}</div>
                  <div class="text-xs text-muted mt-4">Current</div>
                </div>
                <div style="font-size:24px;color:var(--text-muted)">→</div>
                <div style="text-align:center">
                  <div class="score-ring" [ngClass]="scoreClass(enh.improvedScore)">{{ enh.improvedScore }}</div>
                  <div class="text-xs text-muted mt-4">Projected</div>
                </div>
              </div>
              <p class="text-sm">{{ enh.summaryAssessment }}</p>
            </div>

            <!-- Issues -->
            <div class="card mb-16" *ngIf="enh.issues?.length">
              <div class="card-title">🔍 Issues Found</div>
              <div *ngFor="let iss of enh.issues" class="enh-issue"
                   [ngClass]="'enh-' + iss.severity.toLowerCase()">
                <div class="flex gap-8">
                  <span class="gap-severity" [ngClass]="iss.severity">{{ iss.severity }}</span>
                  <div>
                    <div style="font-weight:600;font-size:12px">{{ iss.field }}</div>
                    <div style="font-size:12px;color:var(--danger)">{{ iss.problem }}</div>
                    <div style="font-size:12px;color:var(--success);margin-top:3px">💡 {{ iss.suggestion }}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Epic context insight -->
            <div class="card mb-16" *ngIf="enh.epicContextInsight">
              <div class="card-title">🔗 Epic Context Insight</div>
              <p class="text-sm">{{ enh.epicContextInsight }}</p>
            </div>

            <!-- Suggested AC -->
            <div class="card mb-16" *ngIf="enh.improvedAcceptanceCriteria?.length">
              <div class="card-title">✅ Suggested AC</div>
              <div *ngFor="let ac of enh.improvedAcceptanceCriteria"
                   class="ai-suggestion text-sm">{{ ac }}</div>
            </div>

            <!-- Missing scenarios -->
            <div class="card mb-16" *ngIf="enh.missingScenarios?.length">
              <div class="card-title">⚠️ Missing Scenarios</div>
              <div *ngFor="let sc of enh.missingScenarios" class="missing-sc">{{ sc }}</div>
            </div>

            <!-- Update checklist -->
            <div class="card mb-16">
              <div class="card-title">Completion Checklist</div>
              <div *ngFor="let item of updateChecklist()" class="checklist-row">
                <span style="font-size:16px;flex-shrink:0">{{ item.done ? '✅' : '⬜' }}</span>
                <span style="font-size:13px;flex:1"
                      [style.color]="item.done ? 'var(--success)' : 'var(--text-secondary)'">
                  {{ item.label }}
                </span>
                <span *ngIf="item.required && !item.done"
                      class="badge badge-danger" style="font-size:10px">REQUIRED</span>
              </div>
            </div>

            <div class="alert alert-warning" style="font-size:12px">{{ enh.disclaimer }}</div>
          </ng-container>
        </div>
      </div>
    </ng-container>
  </div>
  `,
  styles: [`
    /* Mode tabs */
    .mode-tabs { display:flex; gap:10px; }
    .mode-tab {
      display:flex; flex-direction:column; align-items:center; gap:2px;
      padding:12px 20px; border:2px solid var(--border); border-radius:var(--radius-lg);
      background:var(--surface); cursor:pointer; flex:1; font-size:14px; font-weight:700;
      color:var(--text-secondary); transition:all .15s;
    }
    .mode-tab:hover { border-color:var(--primary); }
    .mode-tab.active { border-color:var(--primary); background:var(--primary-light); color:var(--primary); }
    .mode-tab-desc { font-size:11px; font-weight:400; color:var(--text-muted); margin-top:2px; }

    /* AI disclaimer */
    .ai-disclaimer {
      display:flex; align-items:flex-start; gap:12px;
      padding:12px 16px; background:#fffbeb; border:1px solid #f59e0b;
      border-radius:var(--radius-lg); font-size:13px; color:#78350f;
    }
    .disclaimer-icon { font-size:18px; flex-shrink:0; margin-top:1px; }

    /* Two-column layout */
    .two-col { display:grid; grid-template-columns:1fr 380px; gap:24px; align-items:start; }

    /* Section head */
    .section-head {
      font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.07em;
      color:var(--text-muted); margin-bottom:16px; padding-bottom:8px;
      border-bottom:1px solid var(--border);
    }
    .field-group-label { font-size:11px; font-weight:700; text-transform:uppercase;
                          letter-spacing:.06em; color:var(--text-muted); margin-bottom:8px; }
    .detail-lbl { font-size:11px; font-weight:700; text-transform:uppercase;
                  letter-spacing:.06em; color:var(--text-muted); margin-bottom:4px; }

    /* Epic source radio cards */
    .epic-source-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .radio-card {
      display:flex; align-items:center; gap:12px; padding:14px 16px;
      border:2px solid var(--border); border-radius:var(--radius-lg);
      cursor:pointer; transition:all .15s; background:var(--surface);
    }
    .radio-card:hover { border-color:var(--primary); }
    .radio-card.selected { border-color:var(--primary); background:var(--primary-light); }
    .radio-icon { font-size:24px; flex-shrink:0; }
    .radio-label { font-size:13px; font-weight:700; color:var(--text-primary); }
    .radio-sub   { font-size:11px; color:var(--text-muted); margin-top:2px; }

    /* Epic info banner */
    .epic-info-banner {
      padding:12px 14px; background:#f5f3ff; border:1px solid #ddd6fe;
      border-radius:var(--radius); margin-bottom:12px;
    }
    .epic-stats-row { display:flex; gap:24px; margin-top:10px; }
    .epic-stat { text-align:center; }
    .es-val { display:block; font-size:22px; font-weight:800; }
    .es-lbl { font-size:11px; color:var(--text-muted); }

    /* Gap row (existing story quality) */
    .gap-row {
      display:flex; flex-direction:column; gap:6px;
      padding:8px 10px; border-radius:var(--radius);
      border:1px solid var(--border); margin-bottom:6px; background:var(--surface);
    }
    .gap-row-flagged { background:#fff5f5; border-color:#fca5a5; }
    .issue-key-sm { font-family:monospace; font-weight:700; font-size:12px; color:var(--primary); width:70px; flex-shrink:0; }
    .score-bar-wrap { flex:1; height:8px; background:var(--bg); border-radius:9px; overflow:hidden; }
    .score-bar-fill { height:100%; border-radius:9px; }
    .score-num { font-size:12px; font-weight:700; width:30px; text-align:right; }
    .gap-findings-mini { display:flex; flex-wrap:wrap; gap:4px; }
    .finding-chip {
      font-size:10px; font-weight:600; padding:2px 7px;
      border-radius:9999px;
    }
    .chip-critical { background:#fee2e2; color:#991b1b; }
    .chip-error    { background:#fef3c7; color:#92400e; }
    .chip-warning  { background:#fffbeb; color:#b45309; }
    .chip-gray     { background:#f1f5f9; color:#475569; }

    /* Epic badge (in create story) */
    .epic-badge {
      display:flex; align-items:center; gap:8px; padding:8px 12px;
      background:#f5f3ff; border:1px solid #ddd6fe; border-radius:var(--radius);
    }
    .epic-key-tag { font-family:monospace; font-weight:700; color:#5b21b6; }
    .epic-name-tag { font-weight:500; color:var(--text-primary); font-size:13px; }
    .btn-icon { background:none; border:none; cursor:pointer; color:var(--text-muted); font-size:18px; }
    .context-hint {
      margin-top:6px; font-size:12px; color:#0369a1;
      background:#e0f2fe; border-radius:var(--radius); padding:6px 10px;
    }

    /* Epic context banner in update mode */
    .epic-context-banner {
      display:flex; align-items:center; padding:8px 12px;
      background:#f5f3ff; border:1px solid #ddd6fe; border-radius:var(--radius);
    }

    /* Generated story cards */
    .gen-card { border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; }
    .gen-card-head {
      display:flex; align-items:center; justify-content:space-between; gap:12px;
      padding:10px 14px; background:var(--bg); border-bottom:1px solid var(--border);
      flex-wrap:wrap;
    }
    .idx-badge {
      width:26px; height:26px; border-radius:50%; background:var(--primary);
      color:#fff; display:flex; align-items:center; justify-content:center;
      font-size:11px; font-weight:700; flex-shrink:0;
    }
    .gen-title { font-size:13px; font-weight:500; flex:1; min-width:0;
                  overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .gen-card-body { padding:14px; }
    .ac-pre {
      font-size:12px; font-family:inherit; white-space:pre-wrap;
      background:var(--bg); padding:10px; border-radius:var(--radius);
      border:1px solid var(--border); line-height:1.5; margin-bottom:0;
    }

    /* Metric mini */
    .metric-mini { text-align:center; padding:10px; background:var(--bg); border-radius:var(--radius); }
    .mm-val { font-size:22px; font-weight:800; color:var(--primary); }
    .mm-lbl { font-size:11px; color:var(--text-muted); margin-top:2px; }

    /* Team pills */
    .team-pills { display:flex; flex-wrap:wrap; gap:8px; }
    .team-pill {
      display:inline-flex; align-items:center;
      padding:5px 12px; border:1px solid var(--border); border-radius:9999px;
      font-size:12px; font-weight:500; cursor:pointer; transition:all .15s; color:var(--text-secondary);
    }
    .team-pill:hover { border-color:var(--primary); color:var(--primary); }
    .team-pill.selected { background:var(--primary-light); border-color:var(--primary); color:var(--primary); }

    /* Issue key badge */
    .issue-key-badge {
      font-family:monospace; font-weight:700; font-size:14px; color:var(--primary);
      padding:2px 6px; background:var(--primary-light); border-radius:4px;
    }

    /* Apply bar */
    .apply-bar {
      display:flex; align-items:center; justify-content:space-between;
      padding:10px 14px; background:#f0fdf4; border:1px solid #bbf7d0;
      border-radius:var(--radius); flex-wrap:wrap; gap:8px;
    }

    /* Enhancement issues */
    .enh-issue { padding:10px 12px; border-radius:var(--radius); margin-bottom:8px; border:1px solid var(--border); }
    .enh-critical { background:#fff5f5; border-color:#fca5a5; }
    .enh-error    { background:#fff7ed; border-color:#fed7aa; }
    .enh-warning  { background:#fffbeb; border-color:#fde68a; }
    .enh-suggestion { background:#f0fdf4; border-color:#bbf7d0; }

    /* Missing scenarios */
    .missing-sc {
      font-size:12px; color:var(--danger); padding:5px 10px;
      border-left:3px solid var(--danger); margin-bottom:5px;
      background:#fff5f5; border-radius:0 4px 4px 0;
    }

    /* Checklist */
    .checklist-row {
      display:flex; align-items:center; gap:8px;
      padding:7px 0; border-bottom:1px solid var(--border);
    }
    .checklist-row:last-child { border-bottom:none; }

    .w-full { width:100%; }
    .justify-center { justify-content:center; }
  `]
})
export class StoryFormComponent implements OnDestroy {

  projectKey = PROJECT;

  modes: Array<{
    key: 'epic' | 'create' | 'update';
    icon: string;
    label: string;
    desc: string;
  }> = [
    { key: 'epic',   icon: '🏗', label: 'Create Epic',   desc: 'Create or inspect epic → generate stories' },
    { key: 'create', icon: '📝', label: 'Create Story',  desc: 'Write new story with AI assistance' },
    { key: 'update', icon: '✏️', label: 'Update Story',  desc: 'Improve an existing JIRA story' },
  ];

  mode = signal<'epic' | 'create' | 'update'>('create');

  prios = [
    { v:'Blocker', l:'Blocker', i:'🔴' }, { v:'Critical', l:'Critical', i:'🟠' },
    { v:'Major', l:'Major', i:'🟡' },     { v:'Medium',   l:'Medium',   i:'🟢' },
    { v:'Minor', l:'Minor', i:'🔵' },     { v:'Low',      l:'Low',      i:'⚪'  },
    { v:'Trivial', l:'Trivial', i:'⬜' },
  ];
  bizLines = [
    { v:'Business', l:'🏢 Business' }, { v:'GT', l:'🌐 GT' },
    { v:'Platform', l:'⚙️ Platform' }, { v:'Infrastructure', l:'🔧 Infrastructure' },
    { v:'Data', l:'📊 Data & Analytics' }, { v:'Security', l:'🔒 Security' },
  ];
  teamOptions = ['Platform Team','Payments Team','Auth Team','Notifications Team','Search Team','Data Team'];

  // ── Mode A state ──────────────────────────────────────────────────────────
  epicSource    = signal<'new' | 'existing'>('existing');
  fetchEpicKey  = '';
  epicInspecting= signal(false);
  epicInspection= signal<any>(null);
  epicCreating  = signal(false);
  createdEpic   = signal<JiraIssue | null>(null);
  epicGenerating= signal(false);
  epicResult    = signal<any>(null);
  epicSprint    = signal<JiraSprint | null>(null);
  epicComponents= signal<any[]>([]);
  epicLabels    = signal<string[]>([]);
  expandedGen   = signal<Set<number>>(new Set());
  numDevs       = 3;
  numQas        = 1;
  devBandwidth  = 8;

  epicForm = this.fb.group({
    epicTitle:       ['', [Validators.required, Validators.minLength(5)]],
    epicDescription: ['', [Validators.required, Validators.minLength(30)]],
    businessLine:    ['', Validators.required],
    priority:        ['Medium'],
  });

  epicReady = computed(() =>
    this.createdEpic() !== null ||
    (this.epicSource() === 'existing' && this.epicInspection() !== null)
  );

  // ── Mode B state ──────────────────────────────────────────────────────────
  storyForm = this.fb.group({
    issueType:          ['Story', Validators.required],
    priority:           ['', Validators.required],
    businessLine:       ['', Validators.required],
    epicLink:           [''],
    title:              ['', [Validators.required, Validators.minLength(5)]],
    description:        ['', [Validators.required, Validators.minLength(20)]],
    acceptanceCriteria: ['', Validators.required],
    storyPoints:        [''],
  });
  validation     = signal<ValidationResult | null>(null);
  aiLoading      = signal(false);
  acGenerating   = signal(false);
  epicSuggesting = signal(false);
  storySaving    = signal(false);
  storySavedKey  = signal('');
  resolvedEpic   = signal<JiraEpic | null>(null);
  epicLinkLoading= signal(false);
  epicNotFound   = signal(false);
  storySprint    = signal<JiraSprint | null>(null);
  storyReporter  = signal<JiraUser | null>(null);
  storyComponents= signal<any[]>([]);
  storyVersions  = signal<any[]>([]);
  storyLabels    = signal<string[]>([]);
  storyTeams     = signal<string[]>([]);

  // ── Mode C state ──────────────────────────────────────────────────────────
  updateKey   = '';
  updateForm  = this.fb.group({
    title:              [''],
    description:        [''],
    acceptanceCriteria: [''],
    priority:           [''],
    storyPoints:        [''],
  });
  storyLoading= signal(false);
  loadedStory = signal<any>(null);
  enhancement = signal<StoryEnhancementResponse | null>(null);
  enhLoading  = signal(false);
  updateSaving= signal(false);
  updateSaved = signal(false);

  // ── Shared lookups ─────────────────────────────────────────────────────────
  sprintOpts   = signal<JiraSprint[]>([]);
  componentOpts= signal<any[]>([]);
  versionOpts  = signal<any[]>([]);
  userOpts     = signal<JiraUser[]>([]);
  sprintsLoading = signal(false);
  compLoading    = signal(false);
  versionsLoading= signal(false);
  usersLoading   = signal(false);

  private destroy$ = new Subject<void>();
  private validate$= new Subject<void>();

  constructor(private fb: FormBuilder, private ai: AiService, private jira: JiraService) {
    this.validate$.pipe(debounceTime(1200), distinctUntilChanged(), takeUntil(this.destroy$))
        .subscribe(() => this.runValidation());
    this.storyForm.valueChanges.pipe(takeUntil(this.destroy$))
        .subscribe(() => {
          if (this.mode() === 'create' && (this.storyForm.value.title?.length ?? 0) > 3)
            this.validate$.next();
        });
    this.loadSprints('');
  }

  setMode(m: 'epic' | 'create' | 'update'): void { this.mode.set(m); }
  setEpicSource(s: 'new' | 'existing'): void {
    this.epicSource.set(s);
    this.epicInspection.set(null);
    this.createdEpic.set(null);
    this.epicResult.set(null);
  }

  // ── Mode A ────────────────────────────────────────────────────────────────

  fetchAndInspectEpic(): void {
    if (!this.fetchEpicKey) return;
    this.epicInspecting.set(true);
    this.epicInspection.set(null);
    this.jira.inspectEpic(this.fetchEpicKey).subscribe({
      next: r => { this.epicInspection.set(r.data); this.epicInspecting.set(false); },
      error: () => this.epicInspecting.set(false)
    });
  }

  createEpicInJira(): void {
    if (this.epicForm.invalid) { this.epicForm.markAllAsTouched(); return; }
    this.epicCreating.set(true);
    const v = this.epicForm.value;
    this.jira.createEpic({
      projectKey: this.projectKey,
      epicName: v.epicTitle!,
      description: v.epicDescription!,
      priority: v.priority!,
      businessLine: v.businessLine!,
    }).subscribe({
      next: r => { this.createdEpic.set(r.data); this.epicCreating.set(false); },
      error: () => this.epicCreating.set(false)
    });
  }

  generateStories(): void {
    this.epicGenerating.set(true);
    this.epicResult.set(null);
    const v = this.epicForm.value;
    const epic = this.createdEpic();
    const insp  = this.epicInspection();
    const req = {
      epicTitle:       epic?.summary ?? insp?.epicName ?? v.epicTitle ?? '',
      epicDescription: v.epicDescription ?? insp?.epicName ?? '',
      epicKey:         epic?.key ?? insp?.epicKey,
      projectKey:      this.projectKey,
      businessLine:    v.businessLine ?? '',
      priority:        v.priority ?? 'Medium',
      sprintName:      this.epicSprint()?.name,
      sprintId:        this.epicSprint()?.id,
      numberOfDevelopers:   this.numDevs,
      numberOfQaEngineers:  this.numQas,
      developerBandwidthSp: this.devBandwidth,
      components: this.epicComponents().map(c => c.name),
      labels: this.epicLabels(),
    };
    this.ai.generateStoriesFromEpic(req).subscribe({
      next: r => { this.epicResult.set(r.data); this.epicGenerating.set(false); },
      error: () => this.epicGenerating.set(false)
    });
  }

  toggleExpGen(i: number): void {
    const s = new Set(this.expandedGen());
    s.has(i) ? s.delete(i) : s.add(i);
    this.expandedGen.set(s);
  }

  useGeneratedStory(story: GeneratedStory): void {
    this.setMode('create');
    const epic = this.createdEpic() ?? this.epicInspection();
    this.storyForm.patchValue({
      title: story.title, description: story.description,
      acceptanceCriteria: story.acceptanceCriteria,
      issueType: story.issueType, priority: story.priority,
      businessLine: story.businessLine,
      storyPoints: story.storyPoints?.toString() ?? '',
      epicLink: story.epicLink || epic?.key || '',
    });
    if (story.epicLink || epic?.key) {
      this.resolvedEpic.set({
        issueKey: story.epicLink || epic?.key || '',
        name: story.title, status: 'In Progress', color: 'purple'
      });
    }
    this.storyComponents.set((story.components ?? []).map(c => ({ name: c })));
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ── Mode B ────────────────────────────────────────────────────────────────

  onEpicInput(e: Event): void {
    this.resolvedEpic.set(null); this.epicNotFound.set(false);
    const v = (e.target as HTMLInputElement).value.toUpperCase();
    (e.target as HTMLInputElement).value = v;
    this.storyForm.get('epicLink')?.setValue(v, { emitEvent: false });
  }

  resolveEpic(): void {
    const key = this.storyForm.value.epicLink?.trim();
    if (!key || this.resolvedEpic()) return;
    this.epicLinkLoading.set(true); this.epicNotFound.set(false);
    this.jira.getEpic(key).subscribe({
      next: r => { this.resolvedEpic.set(r.data); this.epicLinkLoading.set(false); },
      error: () => { this.epicNotFound.set(true); this.epicLinkLoading.set(false); }
    });
  }

  clearEpic(): void {
    this.resolvedEpic.set(null); this.epicNotFound.set(false);
    this.storyForm.get('epicLink')?.setValue('', { emitEvent: false });
  }

  suggestFromEpic(): void {
    const ep = this.resolvedEpic(); if (!ep) return;
    const v = this.storyForm.value;
    this.epicSuggesting.set(true);
    this.ai.suggestAcFromEpicContext({
      epicKey: ep.issueKey, epicName: ep.name, epicDescription: '',
      storyTitle: v.title || '', storyDescription: v.description || '',
      businessLine: v.businessLine || '', issueType: v.issueType || 'Story',
    }).subscribe({
      next: r => {
        this.storyForm.patchValue({ acceptanceCriteria: r.data.join('\n\n') });
        this.epicSuggesting.set(false);
      },
      error: () => this.epicSuggesting.set(false)
    });
  }

  generateAC(): void {
    const v = this.storyForm.value;
    if (!v.title) return;
    this.acGenerating.set(true);
    this.ai.generateAC(v.title!, v.description!).subscribe({
      next: r => { this.storyForm.patchValue({ acceptanceCriteria: r.data.join('\n\n') }); this.acGenerating.set(false); },
      error: () => this.acGenerating.set(false)
    });
  }

  applyAiAc(): void {
    const s = this.validation()?.suggestions?.acceptanceCriteria;
    if (s?.length) this.storyForm.patchValue({ acceptanceCriteria: s.join('\n\n') });
  }

  runValidation(): void {
    const v = this.storyForm.value;
    if (!v.title) return;
    this.aiLoading.set(true);
    this.ai.validate({
      title: v.title!, description: v.description!,
      acceptanceCriteria: v.acceptanceCriteria!,
      issueType: v.issueType!, storyPoints: v.storyPoints ? Number(v.storyPoints) : undefined
    }).subscribe({
      next: r => { this.validation.set(r.data); this.aiLoading.set(false); },
      error: () => this.aiLoading.set(false)
    });
  }

  /** Required-field check. Returns a block message if any required checklist item fails. */
  createBlockReason = computed<string>(() => {
    const failed = this.createChecklist().filter(i => i.required && !i.done);
    if (!failed.length) return '';
    return failed.map(i => i.label).join(', ') + ' must be completed before saving.';
  });

  submitStory(): void {
    if (this.storyForm.invalid || this.createBlockReason()) {
      this.storyForm.markAllAsTouched(); return;
    }
    this.storySaving.set(true);
    const v = this.storyForm.value;
    const epic = this.resolvedEpic();
    this.jira.createIssue({
      projectKey: this.projectKey,
      summary: v.title!, description: v.description!,
      acceptanceCriteria: v.acceptanceCriteria!, issueType: v.issueType!,
      priority: v.priority!, businessLine: v.businessLine!,
      storyPoints: v.storyPoints ? Number(v.storyPoints) : undefined,
      sprintId: this.storySprint()?.id, sprintName: this.storySprint()?.name,
      epicLink: epic?.issueKey ?? v.epicLink ?? undefined, epicName: epic?.name,
      reporterAccountId: this.storyReporter()?.accountId,
      reporterName: this.storyReporter()?.displayName,
      components: this.storyComponents().map(c => c.name),
      fixVersions: this.storyVersions().map(v2 => v2.name),
      labels: this.storyLabels(), teamNames: this.storyTeams(),
    }).subscribe({
      next: r => {
        this.storySavedKey.set(r.data.key); this.storySaving.set(false);
        setTimeout(() => this.storySavedKey.set(''), 4000);
      },
      error: () => this.storySaving.set(false)
    });
  }

  // ── Mode C ────────────────────────────────────────────────────────────────

  loadStory(): void {
    if (!this.updateKey) return;
    this.storyLoading.set(true); this.enhancement.set(null);
    this.jira.getIssue(this.updateKey).subscribe({
      next: r => {
        this.loadedStory.set(r.data);
        this.updateForm.patchValue({
          title: r.data.summary, description: r.data.description,
          acceptanceCriteria: r.data.acceptanceCriteria,
          priority: r.data.priority || 'Medium',
          storyPoints: r.data.storyPoints?.toString() || '',
        });
        this.storyLoading.set(false);
      },
      error: () => this.storyLoading.set(false)
    });
  }

  runEnhancement(): void {
    const ls = this.loadedStory(); if (!ls) return;
    this.enhLoading.set(true);
    this.ai.suggestEnhancements({
      issueKey: ls.key, title: ls.summary, description: ls.description,
      acceptanceCriteria: ls.acceptanceCriteria, issueType: ls.issueType,
      status: ls.status, storyPoints: ls.storyPoints,
      epicLink: ls.epicLink, epicName: ls.epicName,
    }).subscribe({
      next: r => { this.enhancement.set(r.data); this.enhLoading.set(false); },
      error: () => this.enhLoading.set(false)
    });
  }

  applyEnh(field: 'title' | 'desc' | 'all'): void {
    const enh = this.enhancement(); if (!enh) return;
    if (field === 'title' || field === 'all') {
      if (enh.improvedTitle) this.updateForm.patchValue({ title: enh.improvedTitle });
    }
    if (field === 'desc' || field === 'all') {
      if (enh.improvedDescription) this.updateForm.patchValue({ description: enh.improvedDescription });
      if (enh.improvedAcceptanceCriteria?.length)
        this.updateForm.patchValue({ acceptanceCriteria: enh.improvedAcceptanceCriteria.join('\n\n') });
      if (enh.suggestedStoryPoints)
        this.updateForm.patchValue({ storyPoints: enh.suggestedStoryPoints.toString() });
    }
  }

  submitUpdate(): void {
    this.updateSaving.set(true);
    setTimeout(() => {
      this.updateSaving.set(false); this.updateSaved.set(true);
      setTimeout(() => this.updateSaved.set(false), 3000);
    }, 800);
  }

  /** Warning message for update mode — non-blocking but clearly shown. */
  updateChecklistWarning = computed<string>(() => {
    const failed = this.updateChecklist().filter(i => i.required && !i.done);
    if (!failed.length) return '';
    return 'Incomplete required fields: ' + failed.map(i => i.label).join(', ') + '. Story may be flagged by gap detection.';
  });

  // ── Lookups ────────────────────────────────────────────────────────────────

  loadSprints(q: string): void {
    this.sprintsLoading.set(true);
    this.jira.searchSprints(this.projectKey, q).subscribe({
      next: r => { this.sprintOpts.set(r.data); this.sprintsLoading.set(false); },
      error: () => this.sprintsLoading.set(false)
    });
  }
  loadComponents(q: string): void {
    this.compLoading.set(true);
    this.jira.searchComponents(this.projectKey, q).subscribe({
      next: r => { this.componentOpts.set(r.data); this.compLoading.set(false); },
      error: () => this.compLoading.set(false)
    });
  }
  loadVersions(q: string): void {
    this.versionsLoading.set(true);
    this.jira.searchVersions(this.projectKey, q).subscribe({
      next: r => { this.versionOpts.set(r.data); this.versionsLoading.set(false); },
      error: () => this.versionsLoading.set(false)
    });
  }
  loadUsers(q: string): void {
    if (q.length < 2) { this.userOpts.set([]); return; }
    this.usersLoading.set(true);
    this.jira.searchUsers(q).subscribe({
      next: r => { this.userOpts.set(r.data); this.usersLoading.set(false); },
      error: () => this.usersLoading.set(false)
    });
  }
  toggleTeam(sig: ReturnType<typeof signal<string[]>>, t: string): void {
    const ts = sig(); sig.set(ts.includes(t) ? ts.filter(x => x !== t) : [...ts, t]);
  }

  // ── Checklists ─────────────────────────────────────────────────────────────

  createChecklist() {
    const v = this.storyForm.value;
    return [
      { label: 'Title (5+ chars)',        done: (v.title?.length ?? 0) >= 5,           required: true  },
      { label: 'Description (20+ chars)', done: (v.description?.length ?? 0) >= 20,    required: true  },
      { label: 'Acceptance Criteria',     done: !!v.acceptanceCriteria,                 required: true  },
      { label: 'Priority set',            done: !!v.priority,                            required: true  },
      { label: 'Business Line set',       done: !!v.businessLine,                        required: true  },
      { label: 'Story points estimated',  done: !!v.storyPoints,                         required: false },
      { label: 'Sprint assigned',         done: !!this.storySprint(),                   required: false },
      { label: 'Epic linked',             done: !!this.resolvedEpic(),                  required: false },
      { label: 'Component/s added',       done: this.storyComponents().length > 0,      required: false },
      { label: 'AI score ≥ 60',          done: (this.validation()?.qualityScore ?? 0) >= 60, required: false },
    ];
  }

  updateChecklist() {
    const v = this.updateForm.value;
    const ls = this.loadedStory();
    return [
      { label: 'Title present',            done: (v.title?.length ?? 0) >= 5,           required: true  },
      { label: 'Description (20+ chars)',  done: (v.description?.length ?? 0) >= 20,    required: true  },
      { label: 'Acceptance Criteria',      done: !!v.acceptanceCriteria,                 required: true  },
      { label: 'Priority set',             done: !!v.priority,                            required: true  },
      { label: 'Story points estimated',   done: !!v.storyPoints,                         required: false },
      { label: 'Epic linked',              done: !!(ls?.epicLink),                        required: false },
      { label: 'AI improvements applied',  done: this.enhancement() !== null,             required: false },
    ];
  }

  // ── Display helpers ────────────────────────────────────────────────────────

  ei(f: string): boolean { const c = this.epicForm.get(f); return !!(c?.invalid && c?.touched); }
  si(f: string): boolean { const c = this.storyForm.get(f); return !!(c?.invalid && c?.touched); }

  scoreClass(s: number): string { return s >= 75 ? 'high' : s >= 50 ? 'mid' : 'low'; }
  scoreColor(s: number): string {
    return s >= 75 ? 'var(--success)' : s >= 50 ? 'var(--warning)' : 'var(--danger)';
  }
  scoreColorVal(s: number): string { return this.scoreColor(s); }

  ngOnDestroy(): void { this.destroy$.next(); this.destroy$.complete(); }
}
